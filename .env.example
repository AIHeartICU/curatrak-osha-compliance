# Azure AI Foundry
AZURE_AI_FOUNDRY_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_AI_FOUNDRY_API_KEY=your-api-key
AZURE_AI_FOUNDRY_API_VERSION=2023-05-15
AZURE_AI_FOUNDRY_PROJECT=CuraTrak-OSHA-Compliance
AZURE_AI_FOUNDRY_GPT4O_DEPLOYMENT=gpt-4o

# Azure AI Agent - Essential settings for agent functionality
AZURE_AI_AGENT_PROJECT_CONNECTION_STRING=your-connection-string
AZURE_AI_AGENT_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure OpenAI
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/

# Azure Cognitive Search
AZURE_SEARCH_ENDPOINT=https://your-search-endpoint.search.windows.net
AZURE_SEARCH_KEY=your-search-key
AZURE_SEARCH_INDEX_NAME=osha-compliance-index

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=osha-regulations

# Embedding settings
AZURE_AI_FOUNDRY_EMBEDDING_MODEL=my-embedding-model

# Email Configuration
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-password
FROM_EMAIL=your-email@example.com